# ============================================================
# MAGIC PROMPT - Be Media Class
# Copie este arquivo para .env e preencha com seus dados
# ============================================================

# --- Claude AI (Anthropic) ---
# Crie sua chave em: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# --- Instagram / Meta ---
# Veja o README para criar seu App no Meta for Developers
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# --- Servidor ---
# URL pública onde as imagens serão acessíveis pela Meta
# Para testar localmente, use ngrok (instruções no README)
PUBLIC_BASE_URL=https://SEU-SUBDOMINIO.ngrok.io

# --- paper.design (opcional) ---
# O Paper Desktop precisa estar aberto com um arquivo
# O servidor MCP sobe automaticamente em: http://127.0.0.1:29979/mcp
PAPER_MCP_URL=http://127.0.0.1:29979/mcp
USE_PAPER_DESIGN=false
